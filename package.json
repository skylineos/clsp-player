    "paho-mqtt": "1.1.0",
    "promise-timeout": "1.3.0",
    "sleepjs": "4.0.2",
    "srcdoc-polyfill": "1.0.0",
    "url": "0.11.0",
    "uuid": "8.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/eslint-parser": "^7.26.0",
    "@babel/eslint-plugin": "^7.26.0",
