{
  "name": "@skylineos/clsp-player",
  "title": "Skyline CLSP Player",
  "version": "0.23.15",
  "description": "Skyline Technology Solutions' CLSP Video Player.  Stream video in near-real-time in modern browsers.",
  "keywords": [
    "html5",
    "clsp",
    "video",
    "player",
    "skyline"
  ],
  "license": "MIT",
  "repository": "https://github.com/skylineos/clsp-player.git",
  "main": "dist/clsp-player.min.js",
  "scripts": {
    "build": "./scripts/build/build.sh",
    "serve": "./scripts/serve/serve.sh",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "prepack": "NODE_ENV=production yarn run build",
    "postpack": "./scripts/build/pre-build.sh",
    "preversion": "./scripts/version.sh --pre",
    "version": "./scripts/version.sh",
    "postversion": "./scripts/version.sh --post",
    "test:jest": "jest && ./test/jest/scripts/echo-coverage-hyperlink.sh",
    "test": "yarn run test:jest",
    "test:dev": "jest --coverage=false",
    "test:watch": "yarn run test:dev --watch",
    "test:wdio": "start-server-and-test serve http://localhost:8080 wdio",
    "validate:ts": "tsc index.d.ts",
    "wdio": "wdio run wdio.conf.js"
  },
  "dependencies": {
    "@babel/runtime-corejs3": "7.26.10",
    "eventemitter3": "4.0.7",
    "interval-promise": "1.4.0",
